    {
      "id": "r010_text",
      "kind": "text",
      "label": "text",
      "bbox": [
        134,
        1460,
        736,
        1642
      ],
      "image_path": null,
      "reading_order": 10,
      "needs_vlm": false,
      "extracted_text": "The local hardware man or implement dealer will be able to supply all the materials necessary from stock. If not you can easily order them. Use split wood pulleys, as they are most convenient to take off and put on when changes are necessary.",
      "flags": {}
    },
    {
      "id": "r011_text",
      "kind": "text",
      "label": "text",
      "bbox": [
        779,
        1457,
        1383,
        1638
      ],
      "image_path": null,
      "reading_order": 11,
      "needs_vlm": false,
      "extracted_text": "However, the driving pulleys and any such pulleys as maybe needed near the end of the shaft could be made of cast iron or steel, as these will be easily removable from the end of the shaft, and be more permanent than the wood.",
      "flags": {}
    }
