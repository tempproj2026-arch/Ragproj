   "source": [
    "# Qwen2.5-VL-7B OpenAI-Compatible Vision Server for Colab\n",
    "\n",
    "This notebook runs **Qwen2.5-VL-7B-Instruct** on a free Google Colab T4 GPU and exposes an **OpenAI-compatible `/v1/chat/completions` API** over a free Cloudflare tunnel.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Install Dependencies & Cloudflared Tunnel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q torch torchvision --index-url https://download.pytorch.org/whl/cu121\n",
    "!pip install -q transformers==4.49.0 accelerate bitsandbytes qwen-vl-utils fastapi uvicorn pydantic pillow\n",
    "!wget -q -nc https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb\n",
    "!dpkg -i cloudflared-linux-amd64.deb > /dev/null 2>&1\n",
    "print(\"Dependencies and Cloudflared installed successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Load Qwen2.5-VL-7B (4-bit quantization for fast Colab T4 inference)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import Qwen2_5_VLForConditionalGeneration, AutoProcessor, BitsAndBytesConfig\n",
    "\n",
    "model_id = \"Qwen/Qwen2.5-VL-7B-Instruct\"\n",
    "print(f\"Loading {model_id} in 4-bit quantization...\")\n",
    "\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_compute_dtype=torch.bfloat16,\n",
    ")\n",
    "\n",
    "model = Qwen2_5_VLForConditionalGeneration.from_pretrained(\n",
    "    model_id,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    torch_dtype=torch.bfloat16,\n",
    ")\n",
    "processor = AutoProcessor.from_pretrained(model_id, max_pixels=1024*1024)\n",
    "print(\"Model and processor loaded into GPU successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Start Cloudflare Public Tunnel & FastAPI Server"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import re\n",
    "import time\n",
    "import subprocess\n",
    "import traceback\n",
    "import torch\n",
    "import uvicorn\n",
    "from fastapi import FastAPI, Request\n",
    "from fastapi.responses import JSONResponse\n",
    "from qwen_vl_utils import process_vision_info\n",
    "\n",
    "# Clean up GPU memory and previous tunnel process\n",
    "torch.cuda.empty_cache()\n",
    "subprocess.run([\"pkill\", \"-f\", \"cloudflared\"])\n",
    "time.sleep(1)\n",
    "\n",
    "log_file = \"/tmp/cloudflared.log\"\n",
    "if os.path.exists(log_file):\n",
    "    os.remove(log_file)\n",
    "\n",
    "# 1. Start Cloudflared tunnel writing directly to log file\n",
    "tunnel_proc = subprocess.Popen(\n",
    "    [\"cloudflared\", \"tunnel\", \"--url\", \"http://localhost:8000\", \"--logfile\", log_file]\n",
    ")\n",
    "\n",
    "tunnel_url = None\n",
    "print(\"Waiting for Cloudflare Tunnel URL...\")\n",
    "for _ in range(30):\n",
    "    time.sleep(1)\n",
    "    if os.path.exists(log_file):\n",
    "        with open(log_file, \"r\") as f:\n",
    "            content = f.read()\n",
    "        match = re.search(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", content)\n",
    "        if match:\n",
    "            tunnel_url = match.group(0)\n",
    "            break\n",
    "\n",
    "if tunnel_url:\n",
    "    print(\"\\n=======================================================\")\n",
    "    print(f\"SUCCESS! Your public OpenAI endpoint is:\\n{tunnel_url}/v1\")\n",
    "    print(\"\\nPaste this into your local .env file:\")\n",
    "    print(f\"LM_STUDIO_URL={tunnel_url}/v1\")\n",
    "    print(\"VISION_MODEL_NAME=Qwen2.5-VL-7B-Instruct\")\n",
    "    print(\"=======================================================\\n\")\n",
    "else:\n",
    "    print(\"Could not automatically detect tunnel URL. Showing log content:\")\n",
    "    if os.path.exists(log_file):\n",
    "        with open(log_file, \"r\") as f:\n",
    "            print(f.read())\n",
    "\n",
    "# 2. Define OpenAI-compatible FastAPI app\n",
    "app = FastAPI()\n",
    "\n",
    "@app.get(\"/v1/models\")\n",
    "async def get_models():\n",
    "    return {\n",
    "        \"data\": [{\n",
    "            \"id\": \"Qwen2.5-VL-7B-Instruct\",\n",
    "            \"object\": \"model\",\n",
    "            \"owned_by\": \"qwen\"\n",
    "        }]\n",
    "    }\n",
    "\n",
    "@app.post(\"/v1/chat/completions\")\n",
    "async def chat_completions(req: Request):\n",
    "    try:\n",
    "        body = await req.json()\n",
    "        messages = body.get(\"messages\", [])\n",
    "        max_tokens = body.get(\"max_tokens\", 2048)\n",
    "        temperature = body.get(\"temperature\", 0.1)\n",
    "\n",
    "        # Normalize OpenAI image_url to Qwen vision format\n",
    "        norm_messages = []\n",
    "        for msg in messages:\n",
    "            content = msg.get(\"content\")\n",
    "            if isinstance(content, list):\n",
    "                norm_content = []\n",
    "                for part in content:\n",
    "                    if part.get(\"type\") == "image_url":\n",
    "                        img_val = part.get(\"image_url\")\n",
    "                        url = img_val.get(\"url\") if isinstance(img_val, dict) else img_val\n",
    "                        norm_content.append({\"type\": \"image\", \"image\": url})\n",
    "                    elif part.get(\"type\") in [\"text\", \"image\"]:\n",
    "                        norm_content.append(part)\n",
    "                    else:\n",
    "                        norm_content.append(part)\n",
    "                norm_messages.append({\"role\": msg.get(\"role\", \"user\"), \"content\": norm_content})\n",
    "            else:\n",
    "                norm_messages.append(msg)\n",
    "\n",
    "        text = processor.apply_chat_template(\n",
    "            norm_messages, tokenize=False, add_generation_prompt=True\n",
    "        )\n",
    "        image_inputs, video_inputs = process_vision_info(norm_messages)\n",
    "        inputs = processor(\n",
    "            text=[text],\n",
    "            images=image_inputs,\n",
    "            videos=video_inputs,\n",
    "            padding=True,\n",
    "            return_tensors=\"pt\"\n",
    "        ).to(\"cuda\")\n",
    "\n",
    "        with torch.no_grad():\n",
    "            generated_ids = model.generate(\n",
    "                **inputs,\n",
    "                max_new_tokens=max_tokens,\n",
    "                do_sample=(temperature > 0),\n",
    "                temperature=max(0.01, temperature)\n",
    "            )\n",
    "\n",
    "        generated_ids_trimmed = [\n",
    "            out_ids[len(in_ids):] for in_ids, out_ids in zip(inputs.input_ids, generated_ids)\n",
    "        ]\n",
    "        output_text = processor.batch_decode(\n",
    "            generated_ids_trimmed, skip_special_tokens=True, clean_up_tokenization_spaces=False\n",
    "        )[0]\n",
    "\n",
    "        return {\n",
    "            \"id\": f\"chatcmpl-{int(time.time())}\",\n",
    "            \"object\": \"chat.completion\",\n",
    "            \"created\": int(time.time()),\n",
    "            \"model\": \"Qwen2.5-VL-7B-Instruct\",\n",
    "            \"choices\": [{\n",
    "                \"index\": 0,\n",
    "                \"message\": {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": output_text\n",
    "                },\n",
    "                \"finish_reason\": \"stop\"\n",
    "            }],\n",
    "            \"usage\": {\n",
    "                \"prompt_tokens\": len(inputs.input_ids[0]),\n",
    "                \"completion_tokens\": len(generated_ids_trimmed[0]),\n",
    "                \"total_tokens\": len(inputs.input_ids[0]) + len(generated_ids_trimmed[0])\n",
    "            }\n",
    "        }\n",
    "    except Exception as e:\n",
    "        traceback.print_exc()\n",
    "        return JSONResponse(status_code=500, content={\"error\": str(e), \"traceback\": traceback.format_exc()})\n",
    "    finally:\n",
    "        torch.cuda.empty_cache()\n",
    "\n",
    "# 3. Run server using Colab's existing asyncio event loop\n",
    "config = uvicorn.Config(app, host=\"0.0.0.0\", port=8000)\n",
    "server = uvicorn.Server(config)\n",
    "await server.serve()\n"
   ]
  }
 ],
